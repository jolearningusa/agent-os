{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "harness": {
      "const": "hermes"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "mock",
            "ollama"
          ]
        },
        "host": {
          "const": "127.0.0.1"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "api_path": {
          "const": "/v1"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\S+$"
        },
        "context_length_tokens": {
          "type": "integer",
          "minimum": 64000,
          "maximum": 64000
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        }
      },
      "required": [
        "mode",
        "host",
        "port",
        "api_path",
        "model",
        "context_length_tokens",
        "max_output_tokens"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "concurrency": {
          "const": 1
        }
      },
      "required": [
        "max_calls",
        "timeout_seconds",
        "concurrency"
      ]
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "synthetic": {
          "const": true
        },
        "capture_body": {
          "type": "boolean"
        }
      },
      "required": [
        "synthetic",
        "capture_body"
      ]
    }
  },
  "required": [
    "schema_version",
    "harness",
    "source_commit",
    "inference",
    "limits",
    "privacy"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent OS Hermes local configuration v1"
}
