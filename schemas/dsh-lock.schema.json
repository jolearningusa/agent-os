{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "upstream": {
      "const": "https://github.com/deepseek-ai/deepseek-harness.git"
    },
    "fork": {
      "const": "https://github.com/jolearningusa/deepseek-harness.git"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "const": "MIT"
    },
    "source_files_sha256": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "LICENSE": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "package.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pnpm-lock.yaml": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pnpm-workspace.yaml": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tsconfig.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tsconfig.base.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tsdown.config.ts": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "Makefile": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "AGENTS.md": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "SAFETY.md": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "LICENSE",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "tsconfig.base.json",
        "tsdown.config.ts",
        "Makefile",
        "AGENTS.md",
        "SAFETY.md"
      ]
    },
    "upstream_runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "node"
      ]
    },
    "patches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "file",
          "description"
        ]
      }
    },
    "submodule_path": {
      "const": "vendor/dsh"
    }
  },
  "required": [
    "schema_version",
    "upstream",
    "fork",
    "commit",
    "branch",
    "license",
    "source_files_sha256",
    "upstream_runtime",
    "patches",
    "submodule_path"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent OS DeepSeek Harness source lock v1"
}
